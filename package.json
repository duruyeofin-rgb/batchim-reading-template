{
  "name": "batchim-reading",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsx scripts/check.ts",
    "test:missions": "tsx --test scripts/mission.test.ts scripts/mission-sql.test.ts scripts/checkpoint.test.ts",
    "test:missions:browser": "node scripts/mission-browser-check.mjs",
    "test:learning": "tsx --test scripts/learning.test.ts",
    "test:learning:browser": "node scripts/learning-browser-check.mjs",
    "test:entry:browser": "node scripts/entry-browser-check.mjs",
    "build:sql": "node scripts/build-setup-sql.mjs",
    "check:sql": "node scripts/build-setup-sql.mjs --check",
    "verify:install": "node scripts/verify-install.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "playwright-core": "1.56.1",
    "postcss": "^8.4.41",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.10",
    "tsx": "4.20.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
